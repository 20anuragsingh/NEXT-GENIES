# Safe MultiViews handling (avoid 500/503 on shared hosts)
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>
Options -Indexes

# CORS Headers for nextgenies.com and preview domains
<IfModule mod_headers.c>
  SetEnvIfNoCase Origin "^https?://(www\.)?nextgenies\.com$" CORS_OK=1
  SetEnvIfNoCase Origin "^https?://.*\.hostingersite\.com$" CORS_OK=1
  SetEnvIfNoCase Origin "^http://(localhost|127\.0\.0\.1)(:[0-9]+)?$" CORS_OK=1

  Header always set Access-Control-Allow-Origin "%{Origin}e" env=CORS_OK
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
  Header always set Access-Control-Allow-Credentials "true" env=CORS_OK
</IfModule>

# Prerendered pages live in /<route>/index.html (created by `npm run build`); everything else falls back to the SPA.
# CRITICAL: Exclude /api and /uploads so LiteSpeed/Apache passes backend requests to Node.js!
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/api [NC]
  RewriteCond %{REQUEST_URI} !^/uploads [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Compression + caching (hashed build assets are immutable)
<IfModule mod_deflate.c>
  AddFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

# Baseline security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /index.html
